# Copy to .env.local for local dev, and set the same as GitHub Actions "Secrets and variables → Actions → Variables".
# These are PUBLIC (they ship in the built JS) — that's fine: the anon key alone returns
# zero rows because of Row Level Security. Real access requires the shared login (the code).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# The shared viewer account email (its password is the access "code" you give people):
VITE_VIEWER_EMAIL=viewer@lifepro.internal
